---
import OrganizationMark from '../../components/OrganizationMark.astro';
import ResultsFigure from '../../components/ResultsFigure.astro';
import Layout from '../../layouts/PortfolioLayout.astro';
import {base,studies} from '../../data/portfolio';
export function getStaticPaths(){return studies.map(study=>({params:{slug:study.slug},props:{study}}));}
const {study:s}=Astro.props;
const peers=studies.filter(x=>x.mode===s.mode);
const next=peers[(peers.findIndex(x=>x.slug===s.slug)+1)%peers.length];
const related=studies.find(x=>x.slug===s.related);
---
<Layout title={`${s.org} · ${s.title} — Rizwan Haidar`} description={s.intro} mode={s.mode}><div class="case-wrap"><nav class="breadcrumbs" aria-label="Breadcrumb"><a href={`${base}${s.mode}/`}>{s.mode==='academic'?'Academic':'Professional'}</a><span aria-hidden="true"> / </span><span>{s.org}</span></nav><a class="back" href={`${base}${s.mode}/#work`}>← All {s.mode==='academic'?'research':'engineering'} work</a><section class="case-hero"><p class="eyebrow">{s.domains.join(' / ')} · CASE STUDY</p><div class="case-org"><OrganizationMark name={s.org} logo={s.logo}/></div><h1>{s.title}</h1><p class="case-intro">{s.intro}</p><p class="relationship">{s.relationship}</p><div class="case-meta"><strong>{s.metric}</strong><div class="tags">{s.stack.map(t=><span>{t}</span>)}</div></div></section>{s.flow&&<figure class="workflow"><figcaption>WORKFLOW AT A GLANCE <span>{s.slug==='ai-safety'?'Proposed experimental design':'Conceptual summary of the documented approach'}</span></figcaption><ol>{s.flow.map((f,i)=><li><span>0{i+1}</span><strong>{f}</strong></li>)}</ol></figure>}<ResultsFigure slug={s.slug}/><div class="case-body"><aside><p class="eyebrow">IN THIS STUDY</p><nav aria-label="Case study sections">{s.sections.map((section,i)=><a href={`#section-${i}`}>{section.title}</a>)}</nav></aside><div>{s.sections.map((section,i)=><section id={`section-${i}`} class="case-section"><span class="eyebrow">0{i+1}</span><h2>{section.title}</h2><p>{section.text}</p></section>)}<div class="source-note"><p class="eyebrow">SOURCE & ATTRIBUTION</p><p>{s.source}</p>{s.mode==='academic'?<a href={`mailto:rizwanhaidar@outlook.com?subject=${encodeURIComponent('Report request: '+s.title)}`}>Request the supporting report ↗</a>:<a href={`${base}RizwanHaidar_CV.pdf`}>View the public CV ↓</a>}</div>{related&&<a class="related" href={`${base}work/${related.slug}/`}><small>CONTINUE IN THE {related.mode.toUpperCase()} PROFILE</small><strong>{related.title} ↗</strong></a>}</div></div><nav class="next-study" aria-label="Continue exploring"><a class="text-link" href={`${base}${s.mode}/#work`}>← All case studies</a><a href={`${base}work/${next.slug}/`}><small>Next case study</small><strong>{next.title} →</strong></a></nav></div></Layout>
