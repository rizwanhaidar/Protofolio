---
import '../styles/portfolio.css';
import {base} from '../data/portfolio';
const {title='Rizwan Haidar — Data Analytics Engineer',description='Data analytics engineering and computer science research. Explore enterprise data platforms, NLP, graph learning and AI safety.',mode='professional',home=false}=Astro.props;
const canonical=new URL(Astro.url.pathname,'https://rizwanhaidar.github.io').href;
---
<!doctype html><html lang="en" data-mode={mode}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="icon" href={`${base}favicon.svg`}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><meta property="og:image" content={`https://rizwanhaidar.github.io${base}portrait.png`}/><meta name="theme-color" content="#f5f3ed"/>
<script is:inline define:vars={{mode,home,base}}>
try{if(home&&localStorage.getItem('profile-mode')==='academic')location.replace(base+'academic/'+location.hash);else if(!home)localStorage.setItem('profile-mode',mode);}catch{}
</script></head><body><a class="skip" href="#main">Skip to content</a><header><a class="brand" href={base} aria-label="Rizwan Haidar home"><span class="monogram">rh<span>·</span></span><span>Rizwan Haidar<small>Engineering & research</small></span></a><nav class="mode-switch" aria-label="Profile mode"><a data-profile="professional" aria-current={mode==='professional'?'page':undefined} href={`${base}professional/`}>Professional</a><a data-profile="academic" aria-current={mode==='academic'?'page':undefined} href={`${base}academic/`}>Academic</a></nav><a class="header-contact" href="#contact">Get in touch <span>↗</span></a></header><main id="main"><slot/></main><footer id="contact"><div><p class="eyebrow">LET’S CONNECT</p><h2>{mode==='academic'?'Discuss a research question.':'Good data starts with a conversation.'}</h2><p>{mode==='academic'?'For researchers and supervisors working on multilingual NLP, model evaluation or graph ML: get in touch about collaborative evaluations and academic opportunities.':'For data engineering, analytics and enterprise platform conversations.'}</p><a class="contact-mail" href={`mailto:rizwanhaidar@outlook.com?subject=${mode==='academic'?'Research%20conversation':'Data%20engineering%20conversation'}`}>rizwanhaidar@outlook.com ↗</a></div><div class="footer-links"><a href="https://www.linkedin.com/in/rizwanhaidar/">LinkedIn ↗</a><a href="https://github.com/rizwanhaidar">GitHub ↗</a><a href={`${base}RizwanHaidar_CV.pdf`}>Download CV ↓</a><a href={`${base}${mode==='academic'?'professional':'academic'}/`}>Explore the {mode==='academic'?'Professional':'Academic'} profile →</a></div><div class="footer-note">© 2026 Rizwan Haidar · Bonn, Germany<span>Organization names and marks identify affiliations and client work; they do not imply endorsement.</span></div></footer>
<script>
document.querySelectorAll<HTMLAnchorElement>('[data-profile]').forEach(link=>link.addEventListener('click',()=>{try{localStorage.setItem('profile-mode',link.dataset.profile!)}catch{} if(['#work','#background','#expertise','#contact'].includes(location.hash))link.hash=location.hash;}));
</script></body></html>
