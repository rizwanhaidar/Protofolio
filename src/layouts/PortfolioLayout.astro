---
import '../styles/portfolio.css';
import {base} from '../data/portfolio';
const defaults={
  professional:{title:'Rizwan Haidar — Data Engineer',description:'Data engineer in Bonn: legacy-to-cloud migration, ETL/ELT and reconciliation on Snowflake, Teradata, Informatica and Azure. Working student at Toyota Financial Services; ex-Teradata.'},
  academic:{title:'Rizwan Haidar — MSc Computer Science, University of Bonn',description:'MSc Computer Science student at the University of Bonn. Team projects in multilingual NLP, natural language inference and graph learning for anti-money laundering.'}
};
const {mode='professional',home=false}=Astro.props;
const title=Astro.props.title??defaults[mode as 'professional'|'academic'].title;
const description=Astro.props.description??defaults[mode as 'professional'|'academic'].description;
// The root page mirrors the Professional page, so it points search engines there.
const canonical=new URL(home?`${base}professional/`:Astro.url.pathname,'https://rizwanhaidar.github.io').href;
---
<!doctype html><html lang="en" data-mode={mode}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="icon" href={`${base}favicon.svg`}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><meta property="og:image" content={`https://rizwanhaidar.github.io${base}portrait.png`}/><meta name="theme-color" content="#f5f3ed"/>
<script is:inline define:vars={{mode,home,base}}>
try{if(home&&localStorage.getItem('profile-mode')==='academic')location.replace(base+'academic/'+location.hash);else if(!home)localStorage.setItem('profile-mode',mode);}catch{}
</script></head><body><a class="skip" href="#main">Skip to content</a><header><a class="brand" href={base} aria-label="Rizwan Haidar home"><span class="monogram">rh<span>·</span></span><span>Rizwan Haidar<small>Data engineering & research</small></span></a><nav class="mode-switch" aria-label="Profile mode"><a data-profile="professional" aria-current={mode==='professional'?'page':undefined} href={`${base}professional/`}>Professional</a><a data-profile="academic" aria-current={mode==='academic'?'page':undefined} href={`${base}academic/`}>Academic</a></nav><a class="header-contact" href="#contact">Get in touch <span>↓</span></a></header><main id="main"><slot/></main><footer id="contact"><div><p class="eyebrow">LET’S CONNECT</p><h2>{mode==='academic'?'Discuss a research question.':'Good data starts with a conversation.'}</h2><p>{mode==='academic'?'For research collaborations, thesis supervision and academic opportunities in NLP, model evaluation or graph ML.':'For data engineering roles, internships and project conversations. Based in Bonn · English C1 · German A2.'}</p><a class="contact-mail" href={`mailto:rizwanhaidar@outlook.com?subject=${mode==='academic'?'Research%20conversation':'Data%20engineering%20conversation'}`}>rizwanhaidar@outlook.com ↗</a></div><div class="footer-links"><a href="https://www.linkedin.com/in/rizwanhaidar/">LinkedIn ↗</a><a href="https://github.com/rizwanhaidar">GitHub ↗</a><a href={`${base}RizwanHaidar_CV.pdf`}>Download CV ↓</a><a href={`${base}${mode==='academic'?'professional':'academic'}/`}>{mode==='academic'?'Professional':'Academic'} profile →</a></div><div class="footer-note">© 2026 Rizwan Haidar · Bonn, Germany<span>Company names identify employers and clients. Descriptions are generalized and contain no confidential data or code; figures are approximate project measurements.</span></div></footer>
<script>
document.querySelectorAll<HTMLAnchorElement>('[data-profile]').forEach(link=>link.addEventListener('click',()=>{try{localStorage.setItem('profile-mode',link.dataset.profile!)}catch{} if(['#work','#background','#expertise','#contact'].includes(location.hash))link.hash=location.hash;}));
</script></body></html>
