---
const {slug}=Astro.props;
const charts={
'nli':{title:'Accuracy drops outside the training genre',label:'Accuracy (%) · higher is better',caption:'SNLI test accuracy versus MultiNLI validation accuracy (matched and mismatched combined), without any MultiNLI training.',columns:['Model','SNLI','MultiNLI'],rows:[['BERT',91.04,74.31],['DeBERTa',90.30,70.83],['Custom transformer',80.84,44.91]]},
'polarization':{title:'Monolingual polarization detection',label:'Macro-F1 · higher is better',caption:'Monolingual fine-tuning on each language. English labels are sparse and Urdu labels are dense, so the two languages are evaluated separately.',columns:['Model','English','Urdu'],rows:[['RemBERT',.4615,.7630],['XLM-RoBERTa',.3608,.7400]]},
'graph-aml':{title:'Five approaches, one protocol',label:'Illicit-class F1 (%) on AMLworld Small-HI · mean ± std over 5 seeds',caption:'All approaches used the same chronological split and best-validation checkpoint selection.',columns:['Approach','F1','Std'],rows:[['FraudGT + flow attention + temporal features',77.56,1.54],['FraudGT (reproduced)',76.44,1.52],['C2GAT',64.44,1.36],['Multi-GIN + EU (reproduced)',59.97,7.10],['FRAD-B feature reconstruction',54.07,10.72],['D-EMAML',24.89,6.48]]}
};
const c=charts[slug as keyof typeof charts];
---
{c&&<figure class="results-figure"><p class="eyebrow">RESULTS</p><h2>{c.title}</h2><p>{c.label}</p><div class="result-bars" aria-hidden="true">{c.rows.map(r=><div><span>{r[0]}</span><div class="bar-track"><div class="bar" style={`width:${Number(r[1])*(slug==='polarization'?100:1)}%`}></div></div><strong>{r[1]}{slug==='graph-aml'?` ± ${r[2]}`:''}</strong></div>)}</div><table><caption class="sr-only">Complete numeric values for the chart</caption><thead><tr>{c.columns.map(x=><th scope="col">{x}</th>)}</tr></thead><tbody>{c.rows.map(r=><tr>{r.map((x,i)=>i===0?<th scope="row">{x}</th>:<td>{x}</td>)}</tr>)}</tbody></table><figcaption>{c.caption}</figcaption></figure>}
