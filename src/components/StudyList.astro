---
import {research} from '../data/research';
import OrganizationMark from './OrganizationMark.astro';
import {base,studies} from '../data/portfolio';
const {mode}=Astro.props;
const academic=mode==='academic';
const order=['nli','graph-aml','polarization','xaihate','ai-safety'];
const items=studies.filter(s=>s.mode===mode).sort((a,b)=>academic?order.indexOf(a.slug)-order.indexOf(b.slug):0);
---
<section id="work" class="section"><div class="section-heading"><div><p class="eyebrow">{academic?'PROJECTS':'02 / CASE STUDIES'}</p><h2>{academic?'Team projects and research.':'The work, in detail.'}</h2></div><p>{academic?'Master’s coursework, my bachelor’s Final Year Project and a seminar paper.':'Six projects, each with its context, my work and the result.'}</p></div><div class="study-list">{items.map((s,i)=><article class:list={['study',{'featured':i===0}]}><div class="study-identity"><span class="index">{String(i+1).padStart(2,'0')}</span><OrganizationMark name={s.org} logo={s.logo}/><span class="relationship">{academic?research[s.slug].type:s.relationship}</span></div><div class="study-copy"><p class="eyebrow">{s.domains.join(' / ')}</p><h3><a href={`${base}work/${s.slug}/`}>{s.title}</a></h3>{academic?<div class="research-summary"><p>{research[s.slug].finding}</p><p class="project-type">{s.slug==='ai-safety'?'Author':'Team'}: {research[s.slug].team}</p></div>:<p>{s.intro}</p>}<div class="tags">{s.stack.map(t=><span>{t}</span>)}</div></div><div class="study-outcome"><strong>{s.metric}</strong><a class="text-link" href={`${base}work/${s.slug}/`}>Read {academic?'project':'case study'} <span aria-hidden="true">→</span><span class="sr-only">: {s.org} — {s.title}</span></a></div></article>)}</div></section>
