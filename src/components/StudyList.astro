---
import OrganizationMark from './OrganizationMark.astro';
import {base,studies} from '../data/portfolio';
const {mode}=Astro.props;
const items=studies.filter(s=>s.mode===mode);
const domains=[...new Set(items.flatMap(s=>s.domains))];
---
<section id="work" class="section"><div class="section-heading"><div><p class="eyebrow">02 / {mode==='academic'?'RESEARCH & ACADEMIC WORK':'SELECTED ENGINEERING WORK'}</p><h2>{mode==='academic'?'Questions worth investigating.':'The work, in detail.'}</h2></div><p>{mode==='academic'?'Individual research case studies, with methods, evaluation and honest boundaries.':'Enterprise case studies with explicit roles, technical context and documented outcomes.'}</p></div><div class="filters" aria-label="Filter projects by domain"><button type="button" data-filter="All" aria-pressed="true">All work</button>{domains.map(d=><button type="button" data-filter={d} aria-pressed="false">{d}</button>)}</div><p class="result-count" aria-live="polite">{items.length} case studies</p><div class="study-list">{items.map((s,i)=><article class:list={['study',{'featured':i===0}]} data-domains={s.domains.join('|')}><div class="study-identity"><span class="index">{String(i+1).padStart(2,'0')}</span><OrganizationMark name={s.org} logo={s.logo}/><span class="relationship">{s.relationship}</span></div><div class="study-copy"><p class="eyebrow">{s.domains.join(' / ')}</p><h3><a href={`${base}work/${s.slug}/`}>{s.title}</a></h3><p>{s.intro}</p><div class="tags">{s.stack.map(t=><span>{t}</span>)}</div></div><div class="study-outcome"><strong>{s.metric}</strong><a class="text-link" href={`${base}work/${s.slug}/`}>Read case study <span aria-hidden="true">↗</span><span class="sr-only">: {s.org} — {s.title}</span></a></div></article>)}</div><p hidden class="empty">No projects match this filter.</p></section>
<script>
const buttons=document.querySelectorAll<HTMLButtonElement>('[data-filter]');
buttons.forEach(button=>button.addEventListener('click',()=>{const selected=button.dataset.filter;let count=0;buttons.forEach(b=>b.setAttribute('aria-pressed',String(b===button)));document.querySelectorAll<HTMLElement>('[data-domains]').forEach(card=>{card.hidden=selected!=='All'&&!card.dataset.domains!.split('|').includes(selected!);if(!card.hidden)count++;});document.querySelector('.result-count')!.textContent=`${count} case ${count===1?'study':'studies'}`;}));
</script>
