---
import {research} from '../data/research';
import OrganizationMark from './OrganizationMark.astro';
import {base,studies} from '../data/portfolio';
const {mode}=Astro.props;
const order=['nli','graph-aml','polarization','xaihate','ai-safety','clinical-research'];
const items=studies.filter(s=>s.mode===mode).sort((a,b)=>mode==='academic'?order.indexOf(a.slug)-order.indexOf(b.slug):0);
const domains=[...new Set(items.flatMap(s=>s.domains))];
---
<section id="work" class="section"><div class="section-heading"><div><p class="eyebrow">{mode==='academic'?'RESEARCH & ACADEMIC WORK':'02 / SELECTED ENGINEERING WORK'}</p><h2>{mode==='academic'?'Selected research projects.':'The work, in detail.'}</h2></div><p>{mode==='academic'?'Three completed master’s studies lead with their findings. More projects below include the bachelor’s thesis, a proposal and an applied research note.':'Enterprise case studies with explicit roles, technical context and documented outcomes.'}</p></div>{mode==='academic'&&<p class="research-note">These are coursework and thesis reports, a research proposal, and employment research—not peer-reviewed publication claims. Public summaries, selected result figures and evaluation notes are available in each case. Full reports remain request-only pending sharing permission.</p>}<div class="filters" aria-label="Filter projects by domain"><button type="button" data-filter="All" aria-pressed="true">All work</button>{domains.map(d=><button type="button" data-filter={d} aria-pressed="false">{d}</button>)}</div><p class="result-count" aria-live="polite">{items.length} case studies</p><div class="study-list">{items.map((s,i)=><article class:list={['study',{'featured':i===0,'research-note-card':s.slug==='clinical-research'}]} data-domains={s.domains.join('|')}><div class="study-identity"><span class="index">{mode==='academic'?(i<3?'SELECTED STUDY':'MORE PROJECTS'):''} {String(i+1).padStart(2,'0')}</span><OrganizationMark name={s.org} logo={s.logo}/><span class="relationship">{s.relationship}</span></div><div class="study-copy"><p class="eyebrow">{s.domains.join(' / ')}</p><h3><a href={`${base}work/${s.slug}/`}>{s.title}</a></h3><p>{s.intro}</p>{mode==='academic'&&<div class="research-summary"><p class="project-type">{research[s.slug].type}</p><p><strong>My role: </strong>{research[s.slug].role}</p><p><strong>{s.slug==='ai-safety'?'Status':'Finding / scope'}: </strong>{research[s.slug].finding}</p></div>}<div class="tags">{s.stack.map(t=><span>{t}</span>)}</div></div><div class="study-outcome"><strong>{s.metric}</strong><a class="text-link" href={`${base}work/${s.slug}/`}>Read case study <span aria-hidden="true">↗</span><span class="sr-only">: {s.org} — {s.title}</span></a></div></article>)}</div><p hidden class="empty">No projects match this filter.</p></section>
<script>
const buttons=document.querySelectorAll<HTMLButtonElement>('[data-filter]');
buttons.forEach(button=>button.addEventListener('click',()=>{const selected=button.dataset.filter;let count=0;buttons.forEach(b=>b.setAttribute('aria-pressed',String(b===button)));document.querySelectorAll<HTMLElement>('[data-domains]').forEach(card=>{card.hidden=selected!=='All'&&!card.dataset.domains!.split('|').includes(selected!);if(!card.hidden)count++;});document.querySelector('.result-count')!.textContent=`${count} case ${count===1?'study':'studies'}`;}));
</script>
