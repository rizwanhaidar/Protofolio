---
import {base} from '../data/portfolio';
const {name}=Astro.props;
// One logo per organization, all trimmed and shown in the same tile size.
const logos:Record<string,string>={
  'Toyota Financial Services':'toyota-logo.png',
  'Teradata':'teradata-logo.png',
  'Volvo Cars':'volvo-logo.png',
  'Federated Co-operatives':'fcl-logo.png',
  'GIZ':'giz-logo.png',
  'Uniklinik Köln':'uniklinik-logo.png',
  'University of Bonn':'uni-bonn-logo.png',
  'FAST NUCES':'fast-symbol.png'
};
const asset=logos[name];
---
<div class="organization-mark">{asset&&<img src={`${base}logos/${asset}`} alt={`${name} logo`} width="200" height="72"/>}<span>{name}</span></div>
