---
import {base,employers,markets,awards} from '../data/portfolio';
import {certifications} from '../data/certifications';
import Testimonials from './Testimonials.astro';
import OrganizationMark from './OrganizationMark.astro';
import Coursework from './Coursework.astro';
import StudyList from './StudyList.astro';
const {mode='professional'}=Astro.props;const academic=mode==='academic';
const languages='English C1 · German A2 · Urdu and Punjabi (native)';
const stats=academic?[['4','Team projects in NLP and graph learning'],['1.0','Seminar AI Safety grade'],['1.3','Introduction to NLP grade']]:[['2.7','Years of full-time data engineering at Teradata'],['30+','ETL workflows for an enterprise warehouse'],['11+','Countries: Canada, Sweden, GIZ partner countries and 9 Toyota markets'],['5','Teradata awards']];
const expertise=[['Warehousing & migration','Teradata (BTEQ, TPT, GCFR), Informatica PowerCenter and Snowflake. Layered models from landing through staging and core to semantic, with source-to-target mappings.'],['Cloud & processing','Azure (Data Factory, Databricks, ADLS), AWS (Glue, Athena, Lambda, S3) and PySpark.'],['Quality & reconciliation','Data profiling, root-cause analysis, count-and-balance reconciliation and P1/P2 incident triage.'],['Delivery & operations','Terraform, Jenkins, GitHub and Control-M, plus runbooks and SOPs for operations teams. Dashboards in MicroStrategy, Flask and Plotly.']];
---
<section class="hero"><div class="hero-copy"><p class="eyebrow"><span class="status-dot"></span> BONN, GERMANY / {academic?'ACADEMIC PROFILE':'DATA ENGINEER'}</p><h1>Rizwan Haidar<span>{academic?'Multilingual NLP, graph learning and model evaluation.':'Data engineering you can reconcile.'}</span></h1><p class="hero-name">{academic?'MSc Computer Science · University of Bonn · expected winter semester 2027/28':'Working Student, BI & DWH at Toyota Financial Services · Ex-Teradata Associate Data Engineer · MSc Computer Science, University of Bonn'}</p><p class="hero-intro">{academic?'My coursework and team projects ask how models behave outside the conditions they were trained in: across text genres, across languages and on rare classes.':'I move data off legacy systems and prove it arrived intact: migrations, ETL/ELT pipelines and the reconciliation that audit-critical reporting depends on. I spent nearly three years as an Associate Data Engineer at Teradata, delivering for retail and automotive clients in Canada and Sweden. Today I automate regulatory reporting at Toyota Financial Services while completing my MSc in Bonn.'}</p>{!academic&&<p class="hero-facts"><strong>Open to:</strong> data engineering internships from October 2027 and full-time roles after my MSc (winter semester 2027/28).</p>}<div class="actions"><a class="button" href="#work">{academic?'See projects':'See my work'} <span>↓</span></a><a class="secondary" href={`${base}RizwanHaidar_CV.pdf`}>Download CV ↓</a></div><div class="hero-social"><a href="https://www.linkedin.com/in/rizwanhaidar/">LinkedIn ↗</a><a href="https://github.com/rizwanhaidar">GitHub ↗</a><span>{languages}</span></div></div><figure class="portrait"><img src={`${base}portrait.png`} alt="Rizwan Haidar" width="400" height="400" fetchpriority="high"/><figcaption><span>{academic?'RESEARCH + PRACTICE':'DATA + CONTEXT'}</span><strong>{academic?'MSc student, University of Bonn.':'From source to confidence.'}</strong><small>{academic?'NLP · Graph ML · AI Safety':'Snowflake · Teradata · Informatica · Azure'}</small></figcaption></figure></section>
<div class:list={['focus-strip',{'focus-strip--four':!academic}]}>{stats.map(([n,t])=><div><strong>{n}</strong><span>{t}</span></div>)}</div>
{!academic&&<section class="section markets" aria-labelledby="markets-heading"><p class="eyebrow">MARKETS</p><h2 id="markets-heading">Data work across five regions.</h2><div class="markets-grid">{markets.map(m=><article><h3>{m.region}</h3><p>{m.countries}</p><small>{m.via}</small></article>)}</div></section>}
<nav class="section-nav" aria-label="On this page">{academic?<><a href="#work">Projects</a><a href="#background">Education</a><a href="#expertise">Research direction</a></>:<><a href="#background">Experience</a><a href="#work">Case studies</a><a href="#expertise">Expertise & recognition</a></>}<a href="#contact">Contact</a></nav>
{academic&&<StudyList mode={mode}/>}
<section id="background" class="section"><div class="section-heading"><div><p class="eyebrow">{academic?'EDUCATION':'01 / EXPERIENCE'}</p><h2>{academic?'Education.':'Different domains. The same care for data.'}</h2></div><p>{academic?'A master’s in Bonn, built on a data-focused bachelor’s in Islamabad.':'Financial services, enterprise consulting, international development and biomedical informatics.'}</p></div>
{academic?<div class="institutions"><article class="institution bonn"><OrganizationMark name="University of Bonn"/><p class="eyebrow">APRIL 2025 – EXPECTED WINTER SEMESTER 2027/28 · BONN</p><h3>MSc Computer Science</h3><p>University of Bonn</p><p>Intelligent Systems focus. Highlights: Introduction to NLP (1.3) and Seminar AI Safety (1.0).</p><a class="text-link" href="#work">See master’s projects ↑</a></article><article class="institution fast"><OrganizationMark name="FAST NUCES"/><p class="eyebrow">AUGUST 2018 – JUNE 2022 · ISLAMABAD</p><h3>BSc Computer Science</h3><p>National University of Computer and Emerging Sciences</p><p>CGPA 3.33 / 4.00 (≈ German 2.0) · Dean’s List (multiple semesters). Final Year Project: XAIHate (FYP I: A+, FYP II: A).</p><a class="text-link" href={`${base}work/xaihate/`}>Read about XAIHate →</a></article></div>:<div class="employers">{employers.map((e,i)=><article class="employer"><div class="employer-identity"><OrganizationMark name={e.name} logo={e.logo}/><p class="eyebrow">{i===0?'CURRENT':'PREVIOUS'}</p><h3>{e.name}</h3><p>{e.sub}</p></div><div><p class="dates">{e.dates}</p><h4>{e.role}</h4><p class="location">{e.location}</p><p>{e.text}</p><p class="stack">{e.stack}</p><strong class="employer-metric">{e.metric}</strong>{e.engagements&&<table class="engagements"><caption>Client engagements</caption><thead><tr><th scope="col">Period</th><th scope="col">Client</th><th scope="col">Role</th><th scope="col">Highlight</th></tr></thead><tbody>{e.engagements.map(g=><tr><td>{g.period}</td><th scope="row">{g.client}</th><td>{g.role}</td><td>{g.highlight}</td></tr>)}</tbody></table>}<div class="employer-links">{e.links.map(l=><a href={`${base}work/${l.slug}/`}>{l.label} →</a>)}</div></div></article>)}</div>}
{academic&&<Coursework/>}</section>{!academic&&<StudyList mode={mode}/>}
{academic?<section id="expertise" class="section research-agenda"><p class="eyebrow">RESEARCH DIRECTION</p><h2>Evaluation beyond the training setting.</h2><dl><div><dt>Current focus</dt><dd>Evaluation under language and domain shift, and the reliability of model explanations.</dd></div><div><dt>Open question</dt><dd>When model behavior changes under deployment constraints, can explanations still reveal what influenced an answer?</dd></div><div><dt>Recent work</dt><dd>My AI Safety seminar paper designs a controlled study of whether quantized reasoning models still acknowledge the cues that change their answers.</dd></div></dl><a class="text-link" href={`${base}work/ai-safety/`}>Read the seminar paper summary →</a></section>:<section id="expertise" class="section expertise"><div class="section-heading"><div><p class="eyebrow">03 / EXPERTISE</p><h2>Tools in service of the problem.</h2></div><p>The platforms and practices behind the work above.</p></div><div class="expertise-grid">{expertise.map(([t,p],i)=><article><span class="index">0{i+1}</span><h3>{t}</h3><p>{p}</p></article>)}</div><div class="credentials"><h3>Certifications</h3><p>Verify each on Credly.</p><div>{certifications.slice(0,5).map(c=><a href={c.credlyUrl}><img src={base + c.badgeImage.split('/Protofolio/')[1]} alt="" loading="lazy" width="56" height="56"/><span>{c.title}<small>{c.issuer} ↗</small></span></a>)}</div></div><div class="recognition"><h3>Recognized at Teradata</h3><ul>{awards.map(a=><li><strong>{a.award}</strong><time>{a.date}</time>{a.reason&&<span>{a.reason}</span>}</li>)}</ul></div></section>}

{!academic&&<Testimonials/>}
