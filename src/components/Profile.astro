---
import {base,employers} from '../data/portfolio';
import {certifications} from '../data/certifications';
import Testimonials from './Testimonials.astro';
import OrganizationMark from './OrganizationMark.astro';
import FeaturedWork from './FeaturedWork.astro';
import Coursework from './Coursework.astro';
import StudyList from './StudyList.astro';
const {mode='professional'}=Astro.props;const academic=mode==='academic';
---
<section class="hero"><div class="hero-copy"><p class="eyebrow"><span class="status-dot"></span> BONN, GERMANY / {academic?'ACADEMIC PROFILE':'PROFESSIONAL PROFILE'}</p><h1>Rizwan Haidar<span>{academic?'Computer science. A research perspective.':'Data engineering. Built on trust.'}</span></h1><p class="hero-name">Data Analytics Engineer &amp; Computer Science Researcher</p><p class="hero-intro">{academic?'I study language models, graph learning and AI safety, bringing practical experience with enterprise and clinical data to research questions about reliability and evaluation.':'I build and validate the data foundations behind enterprise reporting—from legacy migrations and cloud pipelines to analytics people can trace and trust.'}</p><div class="actions"><a class="button" href="#work">{academic?'Explore research':'Explore selected work'} <span>↗</span></a><a class="secondary" href={`${base}RizwanHaidar_CV.pdf`}>Download CV ↓</a></div><div class="hero-social"><a href="https://www.linkedin.com/in/rizwanhaidar/">LinkedIn ↗</a><a href="https://github.com/rizwanhaidar">GitHub ↗</a><span>{academic?'Industry experience. Research perspective.':'Cloud platforms · Data quality · Business intelligence'}</span></div></div><figure class="portrait"><img src={`${base}portrait.png`} alt="Rizwan Haidar" width="400" height="400" fetchpriority="high"/><figcaption><span>{academic?'RESEARCH + PRACTICE':'DATA + CONTEXT'}</span><strong>{academic?'From systems to scientific questions.':'From source to confidence.'}</strong><small>{academic?'University of Bonn · Computer Science':'Snowflake · Python · SQL · Azure'}</small></figcaption></figure></section>
<div class="focus-strip">{(academic?[['01','NLP & explainability'],['02','Graph machine learning'],['03','AI safety & evaluation']]:[['5+','Toyota migration pipelines'],['9','Markets supported at Toyota'],['15+','Data pipelines at Teradata']]).map(([n,t])=><div><strong>{n}</strong><span>{t}</span></div>)}</div>
<nav class="section-nav" aria-label="On this page"><a href="#background">{academic?'Institutions':'Employers'}</a><a href="#work">{academic?'Research case studies':'Engineering case studies'}</a><a href="#expertise">{academic?'Research interests':'Expertise & credentials'}</a><a href="#contact">Contact</a></nav>
<FeaturedWork mode={mode}/><section id="background" class="section"><div class="section-heading"><div><p class="eyebrow">01 / {academic?'ACADEMIC FOUNDATIONS':'PROFESSIONAL EXPERIENCE'}</p><h2>{academic?'Two institutions. A growing research direction.':'Different domains. The same care for data.'}</h2></div><p>{academic?'Computer science education connecting data systems, language and responsible evaluation.':'Financial services, enterprise consulting, international development and biomedical informatics.'}</p></div>
{academic?<div class="institutions"><article class="institution bonn"><OrganizationMark name="University of Bonn"/><p class="eyebrow">APRIL 2025 – PRESENT · GERMANY</p><h3>MSc Computer Science</h3><p>University of Bonn</p><p>Intelligent Systems specialization, with completed coursework in language processing, AI safety, data analytics and security.</p><a class="text-link" href="#work">Explore master’s-level work ↗</a></article><article class="institution fast"><OrganizationMark name="FAST NUCES"/><p class="eyebrow">AUGUST 2018 – JUNE 2022 · ISLAMABAD</p><h3>BSc Computer Science</h3><p>National University of Computer and Emerging Sciences</p><p>Dean’s List of Honors for Academic Excellence. Bachelor’s thesis: XAIHate.</p><a class="text-link" href={`${base}work/xaihate/`}>Explore the bachelor’s thesis ↗</a></article></div>:<div class="employers">{employers.map((e,i)=><article class="employer"><div class="employer-identity"><OrganizationMark name={e.name} logo={e.logo}/><p class="eyebrow">{i===0?'CURRENT FOCUS':'EMPLOYER'}</p><h3>{e.name}</h3><p>{e.sub}</p></div><div><p class="dates">{e.dates}</p><h4>{e.role}</h4><p class="location">{e.location}</p><p>{e.text}</p><p class="stack">{e.stack}</p><strong class="employer-metric">{e.metric}</strong><div class="employer-links"><a href={`${base}work/${e.slug}/`}>{e.name==='Teradata'?'Volvo Cars engagement':'Explore the work'} ↗</a>{e.name==='Teradata'&&<a href={`${base}work/fcl/`}>Federated Co-operatives engagement ↗</a>}{e.slug==='clinical'&&<a href={`${base}work/clinical-research/`}>Applied research in Academic profile ↗</a>}</div></div></article>)}</div>}
{academic&&<Coursework/>}</section><StudyList mode={mode}/>
<section id="expertise" class="section expertise"><div class="section-heading"><div><p class="eyebrow">03 / {academic?'RESEARCH DIRECTION':'TECHNICAL EXPERTISE'}</p><h2>{academic?'Reliability is a shared question.':'Tools in service of the problem.'}</h2></div><p>{academic?'Interests grounded in the academic work above, with enterprise data engineering as a practical foundation.':'A focused view of capabilities supported by the CV and documented project work.'}</p></div><div class="expertise-grid">{(academic?[
['Language & explanation','NLI, multilingual polarization and hate-speech classification. Evaluating shortcuts, domain shift and interpretable outputs.'],['Graph-based learning','Transaction graphs, message passing and feature reconstruction under severe class imbalance.'],['AI safety','Proposed research on quantization and cue acknowledgment as a proxy for chain-of-thought monitorability.'],['Data & applied research','Statistical data validation, biomedical analytics and reproducible comparisons. Explore the clinical research case study for scope and limitations.']
]:[['Data platforms & cloud','Snowflake at Toyota; Azure Data Factory, Databricks and Fabric in the Volvo engagement; Teradata and Informatica at FCL. AWS experience documented in the CV.'],['Engineering & modeling','SQL, Python, ETL/ELT and reusable data models across landing, staging, core and semantic layers.'],['Analytics & validation','Python reconciliation at Toyota; Microsoft Lists and SharePoint at GIZ; Flask and Plotly for clinical analytics.'],['Delivery & governance','Terraform, Git, Jenkins and Azure DevOps. Runbooks, access guidelines, alerts, retries and schema standards at Teradata.']]).map(([t,p],i)=><article><span class="index">0{i+1}</span><h3>{t}</h3><p>{p}</p></article>)}</div>{!academic&&<div class="credentials"><h3>Professional credentials</h3><p>Credentials listed in the CV. Follow an issuer link to check its current status.</p><div>{certifications.slice(0,5).map(c=><a href={c.credlyUrl}><img src={base + c.badgeImage.split('/Protofolio/')[1]} alt="" loading="lazy" width="56" height="56"/><span>{c.title}<small>{c.issuer} ↗</small></span></a>)}</div></div>}{academic&&<aside class="research-note"><strong>Research reports, not publication claims.</strong><p>The case studies summarize the supplied thesis, coursework reports and proposal. Collaborative results are attributed to their teams. Full reports can be requested; public downloads require the authors’ sharing permission.</p><a href={`${base}work/clinical-research/`}>Explore applied research at Uniklinikum Köln ↗</a></aside>}</section>

{!academic&&<Testimonials/>}
